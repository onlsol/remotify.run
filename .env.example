# ---- Domain ----
# Public hostname for the API, landing page, and relay. Hostname only, no port.
DOMAIN=localhost
# http | https - used in the one-liners returned by /api/session.
SCHEME=https
# Public port for generated URLs. Leave EMPTY for standard ports (80 for http, 443 for https).
# Set to a number (e.g. 8080) when serving behind a non-standard port for local dev.
PUBLIC_PORT=

# ---- nginx ----
# http | tls   (tls requires `--profile tls`)
NGINX_MODE=http
HTTP_PORT=49180
# Unprivileged default in IANA dynamic range (49152-65535). Only relevant when
# NGINX_MODE=tls. Override to 443 for a standalone public HTTPS deploy.
HTTPS_PORT=49443
# Per-IP rate limit on POST /api/session (nginx limit_req syntax: e.g. 10r/m, 2r/s).
RATE_LIMIT=10r/m
RATE_LIMIT_BURST=5
# Max seconds either side of a pipe may wait for the other end.
PROXY_TIMEOUT=3600
# nginx client_max_body_size. 0 = unlimited.
MAX_BODY_SIZE=25m

# ---- API ----
# 1 = log key generation to container stderr.
AUDIT_LOG=0
# Advertised session TTL in the /api/session response (informational only).
SESSION_TTL=3600
# Where the landing page's "source" link redirects to. Leave empty to hide
# the link. Change any time (e.g. from GitLab to GitHub later) without
# touching code - it is just a 302 target.
SOURCE_URL=

# ---- TLS profile only (docker compose --profile tls up -d) ----
CERTBOT_EMAIL=
# 1 = use the ACME staging environment (test-only certs, avoids rate limits).
CERTBOT_STAGING=0

# ---- Tip for local dev ----
# *.localtest.me resolves to 127.0.0.1 automatically - no /etc/hosts edit needed:
#   DOMAIN=remotify.localtest.me
