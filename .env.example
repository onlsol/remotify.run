# ---------------------------------------------------------------------------
# remotify.run configuration. Copy to .env and edit for your deployment:
#   cp .env.example .env
#
# The defaults below are a self-consistent LOCAL HTTP setup: after
# `docker compose up -d` the API and the one-liners it hands out are both
# reachable at http://localhost:49180. For a public HTTPS deploy, see the
# "Production" notes on each block.
# ---------------------------------------------------------------------------

# ---- Domain ----
# Public hostname for the API, landing page, and relay. Hostname only, no port.
# Production: set to your real domain (e.g. relay.example.com).
DOMAIN=localhost
# http | https - baked into the one-liners returned by /api/session. Must match
# how clients actually reach DOMAIN. Production HTTPS: set https.
SCHEME=http
# Public port for generated URLs. Leave EMPTY for the standard port of SCHEME
# (80 for http, 443 for https). Set it when serving on a non-standard port -
# it MUST match the port clients connect to (here HTTP_PORT below).
PUBLIC_PORT=49180

# ---- nginx ----
# http | tls   (tls requires `docker compose --profile tls up -d`)
NGINX_MODE=http
# Host port published for HTTP. For a public TLS deploy set HTTP_PORT=80 as well
# (Let's Encrypt's HTTP-01 challenge must be reachable on port 80).
HTTP_PORT=49180
# Host port published for HTTPS. Only relevant when NGINX_MODE=tls. For a
# standalone public HTTPS deploy set this to 443 (and PUBLIC_PORT empty).
HTTPS_PORT=49443
# Per-IP rate limit on POST /api/session (nginx limit_req syntax: e.g. 10r/m, 2r/s).
RATE_LIMIT=10r/m
RATE_LIMIT_BURST=5
# Max seconds either side of a pipe may wait for the other end. Must comfortably
# exceed LONGPOLL_MS below (nginx fastcgi_read_timeout = this).
PROXY_TIMEOUT=3600
# Max size of a single push. nginx syntax (e.g. 25m, 512k). 0 = unlimited at the
# nginx layer. The API derives its decoded-body / zip-bomb cap (3x this) from
# the same value, so the wire cap and the decoded cap can never drift apart.
MAX_BODY_SIZE=25m
# Long-poll window (ms) the API holds an idle GET /cmd|/result before returning
# 204, so listeners pick up commands sub-second. 0 = legacy immediate 204.
LONGPOLL_MS=15000

# ---- PHP-FPM pool ----
# Max concurrent PHP workers. Each active session pins ~2 workers in long-polls
# for up to LONGPOLL_MS at a time, so this bounds how many sessions can be live
# before short requests (health, session create) start queueing. Raise on busy
# relays, lower on tiny hosts (min effective value ~4).
FPM_MAX_CHILDREN=64

# ---- API ----
# 1 = log key generation to container stderr.
AUDIT_LOG=0
# Idle session TTL in seconds. ENFORCED: every request on the key resets it;
# expired sessions are purged (queue + push history) on next access. Default 3h.
SESSION_TTL=10800
# Where the landing page's "source" link redirects to. Leave empty to hide the
# link. Just a 302 target - change any time without touching code.
SOURCE_URL=

# ---- TLS profile only (docker compose --profile tls up -d) ----
# Required for the tls profile. Contact address sent to the ACME CA.
CERTBOT_EMAIL=
# 1 = use the ACME staging environment (test-only certs, avoids rate limits).
CERTBOT_STAGING=0

# ---- Tip for local dev ----
# *.localtest.me resolves to 127.0.0.1 automatically - no /etc/hosts edit needed:
#   DOMAIN=remotify.localtest.me
